# Frontend Next.js (export statico) — variabili pubbliche.
# NB: con `output: 'export'` queste env sono inlineate a BUILD-TIME.
# Cambiarle richiede un nuovo build/deploy. NON mettere segreti qui:
# sono tutte esposte al client (prefisso NEXT_PUBLIC_).

# DataSource: 'true' = backend Laravel reale via JWT; vuoto/false = demo mock (LocalStorage).
NEXT_PUBLIC_USE_API=

# Base URL delle API Laravel (usata solo se NEXT_PUBLIC_USE_API=true).
NEXT_PUBLIC_API_BASE_URL=https://api.tuodominio.it/api

# Google OAuth Client ID (Google Cloud Console > Credentials > OAuth 2.0 Client ID, tipo Web).
# Se vuoto, il bottone "Continua con Google" usa il fallback demo simulato.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Codice di accesso admin Conflavoro (verifica lato UI dell'onboarding; il
# controllo autorevole resta lato backend). Se vuoto, l'onboarding inoltra
# comunque il codice digitato al backend per la validazione.
NEXT_PUBLIC_ADMIN_INVITE=
